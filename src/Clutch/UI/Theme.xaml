<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Clutch tasarım sistemi.
        Yüzeyler kenarlıkla değil ton farkıyla ayrılır. Yeşil yalnızca "açık" durumunu, kırmızı yalnızca kaydı gösterir.
        Metinler cümle düzeninde; sayılar eş genişlikli rakamlarla (Tabular) ama aynı yazı tipinde.
    -->
    <Color x:Key="ColorBackdrop">#D90A0A0B</Color>
    <Color x:Key="ColorSurface">#1B1B1D</Color>
    <Color x:Key="ColorRaised">#242427</Color>
    <Color x:Key="ColorHover">#2C2C30</Color>
    <Color x:Key="ColorPressed">#202023</Color>
    <Color x:Key="ColorDivider">#2A2A2D</Color>
    <Color x:Key="ColorText">#F2F2F3</Color>
    <Color x:Key="ColorTextSecondary">#A1A1A8</Color>
    <Color x:Key="ColorTextTertiary">#6B6B72</Color>
    <Color x:Key="ColorAccent">#76B900</Color>
    <Color x:Key="ColorAccentHover">#86CC0A</Color>
    <Color x:Key="ColorRecord">#FF4B4E</Color>
    <Color x:Key="ColorWarning">#F0B429</Color>

    <SolidColorBrush x:Key="BrushBackdrop" Color="{StaticResource ColorBackdrop}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushRaised" Color="{StaticResource ColorRaised}" />
    <SolidColorBrush x:Key="BrushHover" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BrushPressed" Color="{StaticResource ColorPressed}" />
    <SolidColorBrush x:Key="BrushDivider" Color="{StaticResource ColorDivider}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushRecord" Color="{StaticResource ColorRecord}" />
    <SolidColorBrush x:Key="BrushRecordSoft" Color="#29FF4B4E" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Logo işareti: geri saran halka (anında tekrar) ortasında kayıt noktası. 24×24 kutuda; tools/make_icon.py ile aynı. -->
    <Geometry x:Key="LogoRing">M12,3 A9,9 0 1 1 4.2,7.5</Geometry>
    <Geometry x:Key="LogoArrow">M12,0.6 L8.8,3 L12,5.4 Z</Geometry>
    <EllipseGeometry x:Key="LogoDot" Center="12,12" RadiusX="3.6" RadiusY="3.6" />

    <!-- Segoe Fluent Icons -->
    <sys:String x:Key="IconReplay">&#xE81C;</sys:String>
    <sys:String x:Key="IconSave">&#xE74E;</sys:String>
    <sys:String x:Key="IconRecord">&#xE7C8;</sys:String>
    <sys:String x:Key="IconStop">&#xE71A;</sys:String>
    <sys:String x:Key="IconCamera">&#xE722;</sys:String>
    <sys:String x:Key="IconFolder">&#xE838;</sys:String>
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <sys:String x:Key="IconClose">&#xE8BB;</sys:String>
    <sys:String x:Key="IconVolume">&#xE767;</sys:String>
    <sys:String x:Key="IconMute">&#xE74F;</sys:String>
    <sys:String x:Key="IconMic">&#xE720;</sys:String>
    <sys:String x:Key="IconMicOff">&#xEC54;</sys:String>
    <sys:String x:Key="IconPlay">&#xF5B0;</sys:String>
    <sys:String x:Key="IconWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="IconImage">&#xE91B;</sys:String>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Rakamları eş genişlikte göster (süre sayarken titremesin) -->
    <Style x:Key="Tabular" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <!-- Yuvarlak, kenarlıksız ikon butonu -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="18">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Metin butonu (Klasörü aç, Geri al) -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aç / kapa anahtarı (Windows 11 ölçülerinde) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="{StaticResource BrushRaised}"
                            BorderBrush="#4A4A50" BorderThickness="1">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                 Fill="{StaticResource BrushTextSecondary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbOffset" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#0E0E0F" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <!-- Devre dışıyken (ör. mikrofon takılı değil) açık görünmesin -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushRaised}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#3A3A40" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#4A4A50" />
                            <Setter TargetName="Track" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
