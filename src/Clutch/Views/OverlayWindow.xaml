<Window x:Class="Clutch.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Clutch.UI.Controls"
        xmlns:vm="clr-namespace:Clutch.ViewModels"
        xmlns:views="clr-namespace:Clutch.Views"
        Title="Clutch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource BrushText}"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Eylem şeridindeki kutucuk: ikon + kısa etiket. Kısayol araç ipucunda. -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Tabular}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>

        <!-- Sağ panel sekmesi -->
        <Style x:Key="Tab" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,22,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <TextBlock Margin="0,0,0,12" FontSize="13" FontWeight="SemiBold" Text="{TemplateBinding Content}" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                    Background="{StaticResource BrushAccent}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Galeri filtresi (bölümlü seçici) -->
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sessize alma -->
        <Style x:Key="MuteToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Width="30" Height="30" Background="Transparent" CornerRadius="15">
                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="14" Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushHover}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushRecord}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ses kanalı -->
        <DataTemplate DataType="{x:Type vm:MixerChannelViewModel}">
            <StackPanel Margin="0,0,0,18">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecorded}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tabular}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="Text" Value="{Binding VolumeText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecorded}" Value="False">
                                        <Setter Property="Text" Value="Kayda alınmıyor" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Text" Value="Cihaz yok" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Name}" />
                </DockPanel>
                <controls:LevelMeter Height="4" Margin="0,10,0,4" LevelDb="{Binding LevelDb}" PeakDb="{Binding PeakDb}" />
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Margin="8,0,-6,0" Style="{StaticResource MuteToggle}"
                                  Content="{Binding Icon}" Tag="{StaticResource IconMute}" IsChecked="{Binding IsMuted}" ToolTip="Sessize al" />
                    <Slider VerticalAlignment="Center" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                            Value="{Binding Volume}" Thumb.DragCompleted="OnVolumeDragCompleted" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Kaynak satırı: etiket + anahtar -->
        <Style x:Key="SourceRow" TargetType="DockPanel">
            <Setter Property="Height" Value="38" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBackdrop}" MouseLeftButtonDown="OnBackdropClick">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="CardOffset" />
        </Grid.RenderTransform>

        <!-- ═══════════ Eylem şeridi ═══════════ -->
        <Border Background="{StaticResource BrushSurface}" MouseLeftButtonDown="OnPanelClick">
            <Grid Height="80">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Margin="26,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource LogoRing}" Stroke="{StaticResource BrushText}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{StaticResource LogoArrow}" Fill="{StaticResource BrushText}" />
                        <Path Data="{StaticResource LogoDot}" Fill="{StaticResource BrushAccent}" />
                    </Canvas>
                    <TextBlock Margin="10,0,0,1" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                               FontSize="18" FontWeight="SemiBold" Text="Clutch" />
                </StackPanel>

                <!-- Eylemler -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Style="{StaticResource ActionTile}" Command="{Binding ToggleReplayCommand}" ToolTip="{Binding ReplayTip}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource IconReplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TileIcon}">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Controller.IsReplayActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Anında tekrar" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionTile}" Command="{Binding SaveReplayCommand}" ToolTip="{Binding SaveTip}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="{StaticResource IconSave}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Klip kaydet" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleRecordingCommand}" ToolTip="{Binding RecordTip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionTile}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Controller.IsRecording}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushRecordSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource BrushRecord}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TileIcon}">
                                        <Setter Property="Text" Value="{StaticResource IconRecord}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Controller.IsRecording}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource IconStop}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TileLabel}">
                                        <Setter Property="Text" Value="Kayıt" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Controller.IsRecording}" Value="True">
                                                <Setter Property="Text" Value="{Binding Controller.RecordingElapsed}" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionTile}" Command="{Binding ScreenshotCommand}" ToolTip="{Binding ScreenshotTip}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Text="{StaticResource IconCamera}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Ekran görüntüsü" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="30" Margin="14,0" Background="{StaticResource BrushDivider}" />

                    <Button Style="{StaticResource ActionTile}" Command="{Binding OpenFolderCommand}" ToolTip="Kayıt klasörünü Gezgin'de aç">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileIcon}" Foreground="{StaticResource BrushTextSecondary}" Text="{StaticResource IconFolder}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="Klasör" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Margin="0,0,18,0" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                        Content="{StaticResource IconClose}" ToolTip="{Binding CloseTip}" AutomationProperties.Name="Kapat"
                        Command="{Binding CloseCommand}" />
            </Grid>
        </Border>

        <!-- ═══════════ Galeri + sağ panel ═══════════ -->
        <Grid Grid.Row="1" Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Galeri / kırpma -->
            <Border Background="{StaticResource BrushSurface}" CornerRadius="10" MouseLeftButtonDown="OnPanelClick">
                <Grid>
                <views:TrimView x:Name="Trim" Visibility="{Binding IsTrimming, Converter={StaticResource BoolToVis}}" />
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrimming}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <DockPanel DockPanel.Dock="Top" Margin="22,18,16,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" Text="{StaticResource IconFolder}" />
                                <TextBlock Text="Klasörü aç" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Heading}" Text="Galeri" />
                        <StackPanel Margin="22,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Tümü" Command="{Binding SetFilterCommand}" CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Filter}" Value="All">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Videolar" Command="{Binding SetFilterCommand}" CommandParameter="Videos">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Filter}" Value="Videos">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Ekran görüntüleri" Command="{Binding SetFilterCommand}" CommandParameter="Screenshots">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Filter}" Value="Screenshots">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Clips}" Margin="16,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="6,0,6,18" Focusable="False" Cursor="Hand"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.OpenClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Aç" Command="{Binding OpenClipCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Kırp" Command="{Binding TrimClipCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.DataContext.IsVideo, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                                    <MenuItem Header="Klasörde göster" Command="{Binding RevealClipCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Separator />
                                                    <MenuItem Header="Sil" Command="{Binding DeleteClipCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel Width="232" Background="Transparent">
                                                        <Grid Height="130">
                                                            <Border CornerRadius="6" Background="#111113">
                                                                <Border.OpacityMask>
                                                                    <VisualBrush>
                                                                        <VisualBrush.Visual>
                                                                            <Border Width="232" Height="130" CornerRadius="6" Background="Black" />
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Border.OpacityMask>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>
                                                            <Border x:Name="Hover" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource BrushText}"
                                                                    Background="#26000000" Opacity="0" />
                                                            <Border x:Name="Play" Width="40" Height="40" CornerRadius="20" Background="#B3000000" Opacity="0"
                                                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Margin="2,0,0,0" Foreground="White"
                                                                           Text="{StaticResource IconPlay}" />
                                                            </Border>
                                                            <Border Margin="8" Padding="5,1,5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    CornerRadius="4" Background="#CC000000"
                                                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Style="{StaticResource Tabular}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                           Text="{Binding Duration}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Margin="1,9,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Game}" />
                                                        <TextBlock Margin="1,2,0,0" Style="{StaticResource Caption}" Text="{Binding When}" />
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                                            <Setter TargetName="Play" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Boş durum -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Clips.IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Canvas Width="24" Height="24" Opacity="0.35">
                                <Path Data="{StaticResource LogoRing}" Stroke="{StaticResource BrushText}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="{StaticResource LogoArrow}" Fill="{StaticResource BrushText}" />
                                <Path Data="{StaticResource LogoDot}" Fill="{StaticResource BrushText}" />
                            </Canvas>
                            <TextBlock Margin="0,16,0,6" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Burada henüz bir şey yok" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="Bir an kaçırmak üzereyken" />
                                <Run Text="{Binding Controller.Settings.Hotkeys.SaveReplay, Mode=OneWay}" Foreground="{StaticResource BrushText}" />
                                <Run Text="tuşuna bas." />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DockPanel>
                </Grid>
            </Border>

            <!-- Sağ panel -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurface}" CornerRadius="10" MouseLeftButtonDown="OnPanelClick">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Margin="22,18,22,0" Orientation="Horizontal">
                            <Button Content="Ses" Command="{Binding ShowAudioCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Tab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsTab}" Value="False">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Ayarlar" Command="{Binding ShowSettingsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Tab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BrushDivider}" />
                    </StackPanel>

                    <Grid>
                        <!-- Ses -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="22,18,22,18">
                                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Caption}" Text="Kayda alınanlar" />
                                    <DockPanel Style="{StaticResource SourceRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Sistem sesi" IsChecked="{Binding SystemAudioRecorded}" />
                                        <TextBlock VerticalAlignment="Center" Text="Sistem sesi" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SourceRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Mikrofon" IsChecked="{Binding MicrophoneRecorded}"
                                                  IsEnabled="{Binding HasMicrophone}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Mikrofon" />
                                            <TextBlock Margin="0,1,0,0" FontSize="11.5" Foreground="{StaticResource BrushTextTertiary}" Text="Cihaz bulunamadı">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMicrophone}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SourceRow}">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Fare imleci" IsChecked="{Binding CursorCaptured}" />
                                        <TextBlock VerticalAlignment="Center" Text="Fare imleci" />
                                    </DockPanel>

                                    <Border Height="1" Margin="0,16,0,18" Background="{StaticResource BrushDivider}" />

                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="Ses düzeyi" />
                                    <ContentControl Content="{Binding SystemChannel}" />
                                    <ContentControl Content="{Binding MicChannel}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Ayarlar: panelin DataContext'i ayar taslağıdır; görünürlük dıştaki Grid'den overlay modeline bağlanır -->
                        <Grid Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                            <views:SettingsPanel x:Name="Settings" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
