<Window x:Class="Clutch.Views.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clutch"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="#E61B1B1D" CornerRadius="13" Padding="10,5,12,6">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{StaticResource BrushRecord}">
                <Ellipse.Triggers>
                    <!-- Yavaş nabız: kaydın sürdüğünü hissettirir, dikkat dağıtmaz -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                       Typography.NumeralAlignment="Tabular" Text="{Binding RecordingElapsed}" />
        </StackPanel>
    </Border>
</Window>
